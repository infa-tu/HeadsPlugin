//
// Dished head parameters input dialog
//

IDD_DISHED_HEAD_DLG DIALOGEX 0, 0, 240, 170
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
